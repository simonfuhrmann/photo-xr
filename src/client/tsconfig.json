{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2020",
    "lib": ["ES2022", "DOM"],
    "outDir": "build/",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "watchOptions": {
    "excludeDirectories": [
      "**/node_modules",
      "build/*"
    ]
  }
}
